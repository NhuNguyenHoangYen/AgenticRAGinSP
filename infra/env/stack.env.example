# Environment for infra/compose/compose.yaml.
#
#   cp infra/env/stack.env.example infra/env/stack.env
#   chmod 600 infra/env/stack.env
#
# stack.env holds secrets and is ignored by Git. This file is loaded into the
# api and worker containers, and Compose also reads it for the ${...} values
# in compose.yaml when started with:  --env-file infra/env/stack.env

# ---------------------------------------------------------------------------
# Answer generation (required for questions; ingestion works without it)
# LLM_PROVIDER: openai | azure_openai | cohere
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=

# COHERE_API_KEY=
# COHERE_MODEL=command-a-03-2025

# ---------------------------------------------------------------------------
# Embeddings. Changing these after documents are indexed points the stack at
# a different collection; existing documents are not migrated.
# ---------------------------------------------------------------------------
API_EMBEDDING_PROVIDER=huggingface
API_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
API_QDRANT_COLLECTION_PREFIX=agentic-rag-api

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
MONGODB_DATABASE=agentic_rag
LOG_LEVEL=INFO
EVALUATION_CAPTURE_ENABLED=false
INGESTION_MAX_ATTEMPTS=3
INGESTION_TIMEOUT_SECONDS=900

# ---------------------------------------------------------------------------
# Compose-level settings (images, ports and resource limits)
# ---------------------------------------------------------------------------
IMAGE_TAG=local

# Reverse proxy: the only published port.
# 127.0.0.1 = SSH tunnel only; 0.0.0.0 = whole LAN (Basic Auth still required).
PROXY_BIND=127.0.0.1
PROXY_PORT=8080
PROXY_MEMORY_LIMIT=128m

MONGODB_CACHE_GB=0.25
MONGODB_MEMORY_LIMIT=1g
QDRANT_MEMORY_LIMIT=1g
API_CPUS=2
API_MEMORY_LIMIT=3g
WORKER_CPUS=2
WORKER_MEMORY_LIMIT=3g
UI_MEMORY_LIMIT=512m
