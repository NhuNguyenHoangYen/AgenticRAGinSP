# Answer generation provider: openai, cohere or azure_openai.
# Restart Streamlit after changing this file.
LLM_PROVIDER=openai

# OpenAI answer generation (use a model supporting tool calling).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Cohere answer generation, or Cohere embeddings even when using OpenAI LLM.
COHERE_API_KEY=
COHERE_MODEL=command-a-03-2025

# Embeddings are selected separately in the Streamlit sidebar.
# Choose Hugging Face embeddings to use OpenAI without a Cohere API key.

# Qdrant vector database (start with docker compose up -d qdrant).
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=index-ai-report-2025
QDRANT_API_KEY=

# Azure OpenAI: select LLM_PROVIDER=azure_openai after filling these values.
# Endpoint is the resource root URL; deployment is your Azure deployment name.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# Structured logging (paths relative to project root).
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
APP_ENV=development
APP_VERSION=unknown
# Opt in to storing full questions, answers, history and retrieved document text.
EVALUATION_CAPTURE_ENABLED=false
EVALUATION_BACKUP_COUNT=10

# DeepEval scoring reuses LLM_PROVIDER and the same provider settings above.

# FastAPI backend foundation (milestone A; development identity only).
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=agentic_rag
MONGODB_TIMEOUT_MS=5000
DEV_USER_ID=development-user
DEV_USER_NAME=Local developer
# Keep APP_ENV=development for the fixed-identity backend; real auth is not implemented.

# Milestone B single-document API (LLM still uses LLM_PROVIDER above).
UPLOAD_DIR=var/uploads
API_EMBEDDING_PROVIDER=huggingface
API_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
# The backend adds an embedding-profile hash; existing report collection is untouched.
API_QDRANT_COLLECTION_PREFIX=agentic-rag-api

# Milestone C: run python -m src.workers.ingestion separately from FastAPI.
INGESTION_MAX_ATTEMPTS=3
INGESTION_LEASE_SECONDS=90
INGESTION_POLL_SECONDS=2
INGESTION_RETRY_SECONDS=5
UPLOAD_MAX_FILES=10
UPLOAD_BATCH_BYTES=104857600
INGESTION_TIMEOUT_SECONDS=900

# Milestone D: total rendered retrieval characters per question (not a token limit).
QA_CONTEXT_MAX_CHARS=48000

# Streamlit calls FastAPI; provider credentials are consumed by API/worker only.
API_BASE_URL=http://127.0.0.1:8000
