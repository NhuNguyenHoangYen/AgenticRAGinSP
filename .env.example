# Answer generation provider: openai or cohere.
# Restart Streamlit after changing this file.
LLM_PROVIDER=openai

# OpenAI answer generation (use a model supporting tool calling).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Cohere answer generation, or Cohere embeddings even when using OpenAI LLM.
COHERE_API_KEY=
COHERE_MODEL=command-a-03-2025

# Embeddings are selected separately in the Streamlit sidebar.
# Choose Hugging Face embeddings to use OpenAI without a Cohere API key.
